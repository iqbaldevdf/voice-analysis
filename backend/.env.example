PORT=5050
AI_SERVICE_URL=http://127.0.0.1:8001
DUAL_STT_ENABLED=false
RECORDINGS_DIR=../recordings
NORMALIZED_DIR=./data/normalized
UPLOADS_DIR=./data/uploads
EXPORTS_DIR=./data/exports
JOBS_FILE=./data/jobs.json
FFMPEG_CONCURRENCY=2

FRESHCALLER_BASE_URL=https://datafortunecallcenter.freshcaller.com
FRESHCALLER_API_AUTH=changeme
FRESHCALLER_POLL_INTERVAL_MS=4000
FRESHCALLER_MAX_POLL_ATTEMPTS=90
FRESHCALLER_CRON_ENABLED=true
FRESHCALLER_CRON_EXPR=0 1 * * *
FRESHCALLER_CRON_TZ=Asia/Kolkata
CRON_LOG_TTL_DAYS=90

# Local Docker: mongodb://127.0.0.1:27017/voice_analysis
# Production Atlas (required path /voice_analysis) — keep until F12 cutover:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/voice_analysis?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/voice_analysis

# F12 — local Postgres (TypeORM). Optional until cutover; when set, backend connects + migrates.
# docker compose up -d postgres
DATABASE_URL=postgres://voiceiq:voiceiq@127.0.0.1:5432/voice_analysis
# Phase 3: prefer Postgres for API reads when connected (set false to force Mongo reads)
# POSTGRES_READS=true
# TYPEORM_LOGGING=true

FC_RECORDINGS_DIR=./data/fc-recordings

# F11 dual audio storage: false/omit = local disk only; true + bucket = S3 durable store
S3_ENABLED=false
# S3_AUDIO_BUCKET=voiceiq-prod-audio
# AWS_REGION=ap-south-1
# Only if not using an EC2/instance role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
