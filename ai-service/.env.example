HOST=127.0.0.1
PORT=8001
ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_API_KEY
ASSEMBLYAI_SPEECH_MODEL=universal-2
ASSEMBLYAI_ENABLE_LLM=true
ASSEMBLYAI_LLM_MODEL=qwen3.5-4b-32k-fast
ASSEMBLYAI_LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com/v1/chat/completions
ASSEMBLYAI_POLL_INTERVAL_SEC=3

# Dual STT (F08): off = AssemblyAI only; set true to enable Whisper compare + review gate
DUAL_STT_ENABLED=false
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPT_AGREE_WER_MAX=0.12
TRANSCRIPT_AGREE_MIN_SIMILARITY=0.88

# Audio-based speaker validation (F07): ECAPA embeddings on suspicious A/B islands.
# Default off — enable only after torch+speechbrain+checkpoint are installed (see requirements-speaker-validation.txt).
AUDIO_SPEAKER_VALIDATION=false
SPEAKER_EMBEDDING_MODEL_DIR=
AUDIO_SV_MIN_PROFILE_SEC=1.5
AUDIO_SV_MIN_SPEECH_SEC=1.0
AUDIO_SV_ISLAND_MAX_SEC=3.0
AUDIO_SV_CONFIRM_MARGIN=0.08
AUDIO_SV_CORRECT_MARGIN=0.15
# Phase 3 — robust profiles + boundary validation
AUDIO_SV_OUTLIER_SIM_MIN=0.35
AUDIO_SV_USABLE_MIN_SEGMENTS=2
AUDIO_SV_USABLE_MIN_SPEECH_SEC=3.0
AUDIO_SV_USABLE_MIN_WITHIN_SIM=0.40
AUDIO_SV_WEAK_SEPARATION_COSINE=0.55
AUDIO_SV_BOUNDARY_VALIDATION=true
AUDIO_SV_BOUNDARY_WINDOW_SEC=2.0
AUDIO_SV_LONG_TURN_SCAN=false
AUDIO_SV_LONG_TURN_VALIDATION=false
AUDIO_SV_LONG_TURN_MIN_SEC=8.0
AUDIO_SV_LONG_TURN_WINDOW_SEC=1.5
AUDIO_SV_LONG_TURN_HOP_SEC=0.75
AUDIO_SV_LONG_TURN_MIN_WINDOWS=3
ASSEMBLYAI_SPEAKERS_EXPECTED=2
